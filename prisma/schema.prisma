generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  MISTICO
  ORACULO
}

enum Role {
  USER
  ADMIN
}

enum AuthTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum UsageKind {
  DREAM
  ASTRAL
  TAROT_THREE
  COMPATIBILITY
  NUMEROLOGY
  SOLAR_RETURN
}

enum UsageSource {
  PLAN // consumiu a cota mensal do plano
  CREDIT // consumiu um crédito de consulta avulsa
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum ReadingKind {
  ASTRAL
  TAROT_DAILY
  TAROT_THREE
  COMPATIBILITY
  NUMEROLOGY
  SOLAR_RETURN
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  password        String
  role            Role      @default(USER)
  emailVerifiedAt DateTime?
  termsAcceptedAt DateTime?
  tokenVersion    Int       @default(0) // incrementa ao redefinir a senha: invalida sessões antigas
  dailyEmail      Boolean   @default(true)
  lastDailyEmail  DateTime?

  // Dados de nascimento (mapa astral)
  birthDate  String? // YYYY-MM-DD
  birthTime  String? // HH:mm (hora local do nascimento)
  birthPlace String?
  birthLat   Float?
  birthLon   Float?
  birthTz    String? // IANA, ex.: America/Sao_Paulo
  sunSign    String? // slug do signo solar, ex.: "escorpiao"

  // Assinatura (sincronizada via webhook Stripe)
  plan                 Plan      @default(FREE)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dreams    Dream[]
  readings  Reading[]
  usage     UsageEvent[]
  tokens    AuthToken[]
  credits   CreditBalance[]
  purchases Purchase[]
}

model Dream {
  id          String @id @default(uuid())
  title       String
  description String
  type        String
  emotion     String
  scenerie    String
  intensity   Int

  interpretation String
  keySymbolism   String
  warnings       String?
  luckNumbers    String?
  moonPhase      String? // ex.: "Lua Cheia em Escorpião"
  astroContext   String? // resumo do clima astral usado na leitura

  imagePromptLiteral  String?
  imagePromptAbstract String?

  isFavorite Boolean @default(false)
  shareToken String? @unique

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Reading {
  id        String      @id @default(uuid())
  kind      ReadingKind
  input     Json
  output    Json
  createdAt DateTime    @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
}

model UsageEvent {
  id        String      @id @default(uuid())
  kind      UsageKind
  source    UsageSource @default(PLAN)
  createdAt DateTime    @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
}

model AuthToken {
  id        String        @id @default(uuid())
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Horoscope {
  id        String   @id @default(uuid())
  sign      String
  date      String // YYYY-MM-DD (America/Sao_Paulo)
  content   Json
  createdAt DateTime @default(now())

  @@unique([sign, date])
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

model StripeEvent {
  id          String   @id // event.id do Stripe (idempotência)
  type        String
  processedAt DateTime @default(now())
}

/// Saldo de consultas avulsas compradas (não expiram).
model CreditBalance {
  userId    String
  kind      UsageKind
  balance   Int       @default(0)
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind])
}

/// Compra única (consulta avulsa / pacote). Criada como PENDING no checkout; vira PAID pelo webhook ou no retorno.
model Purchase {
  id                    String         @id @default(uuid())
  productId             String // id do catálogo em lib/products.ts
  kind                  UsageKind
  quantity              Int
  amount                Int // centavos (BRL)
  currency              String         @default("brl")
  status                PurchaseStatus @default(PENDING)
  stripeSessionId       String?        @unique
  stripePaymentIntentId String?        @unique
  paidAt                DateTime?
  refundedAt            DateTime?
  createdAt             DateTime       @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}
