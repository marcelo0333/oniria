# ───────────── Obrigatórias ─────────────
# Postgres (Neon/Supabase/RDS/…). Em produção use SSL: ...?sslmode=require
DATABASE_URL="postgresql://oniria:oniria@localhost:5432/oniria"
# 32+ caracteres aleatórios:  openssl rand -base64 48
SESSION_SECRET="troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres"
# URL pública do site (sem barra no final). Usada em e-mails, sitemap, OG e redirecionamentos do Stripe.
APP_URL="http://localhost:3000"
# Gemini (Google AI Studio) — use o plano PAGO (billing ativo) para que os dados não sejam usados em treinamento.
GOOGLE_GENAI_API_KEY="GEMINI_API_KEY_GOES_HERE"

# ───────────── Opcionais com padrão ─────────────
GEMINI_MODEL="gemini-2.5-flash"
# Pollinations (imagens). Sem chave funciona com limites menores. NUNCA use NEXT_PUBLIC_ aqui.
POLLINATIONS_API_KEY=""

# ───────────── Pagamentos (Stripe) ─────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# IDs dos preços (price_...) do plano Místico criados no Stripe (scripts/stripe-setup.mjs)
STRIPE_PRICE_MISTICO_MONTHLY=""
STRIPE_PRICE_MISTICO_YEARLY=""
# Dias de teste grátis na 1ª assinatura (cartão obrigatório; 0 desliga). Padrão: 3
STRIPE_TRIAL_DAYS="3"

# ───────────── E-mail (Resend) ─────────────
RESEND_API_KEY=""
EMAIL_FROM="Oniria <no-reply@seudominio.com.br>"
SUPPORT_EMAIL="suporte@seudominio.com.br"

# ───────────── Cron e dados da empresa ─────────────
# Segredo do cron diário (Vercel Cron envia como Authorization: Bearer ...). openssl rand -hex 32
CRON_SECRET=""
# Responsável pelo app (aparece nos Termos e na Privacidade). Pessoa física: seu nome e CPF.
COMPANY_NAME="Seu Nome Completo"
# CPF (pessoa física) ou CNPJ — o rótulo é detectado pelo número de dígitos
COMPANY_DOCUMENT="000.000.000-00"
# Endereço físico ou caixa postal (exigido pelo Decreto 7.962/2013 para comércio eletrônico)
COMPANY_ADDRESS=""
DPO_EMAIL="privacidade@seudominio.com.br"

# ───────────── Somente testes/staging ─────────────
# GEMINI_BASE_URL=http://localhost:4010   # servidor Gemini falso (tests/e2e/fake-gemini.mjs)
# EMAIL_LOG_TO_CONSOLE=1                  # imprime e-mails (com links) no log quando RESEND_API_KEY está vazio
# DATABASE_POOL_MAX=10
